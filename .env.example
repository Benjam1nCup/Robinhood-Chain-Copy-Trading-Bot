# Robinhood Chain Copy Trading Bot — secrets only in .env
# Docs: https://docs.robinhood.com/chain/connecting/

# RPC (use Alchemy/QuickNode for production)
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_WS_URL=

# Wallet (never commit real keys)
PRIVATE_KEY=
WALLET_ADDRESS=

# 0x Swap API for official Stock Token RFQ liquidity
ZEROX_API_KEY=

# Safety gates — all three required for live trading
DRY_RUN=true
PAPER_TRADING=true
CONFIRM_LIVE_TRADING=NO

# Emergency stop without restarting
STOP_TRADING=false
